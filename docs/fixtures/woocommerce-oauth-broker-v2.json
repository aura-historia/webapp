{
  "description": "Sanitized fixtures of the WooCommerce OAuth broker protocol v2 as the WooCommerce extension (aura-historia/woocommerce-extension, from 0.3.2) sends and validates it. Values are examples; random values are 32 bytes as base64url without padding. The normative contract is docs/oauth-protocol-guidelines.md.",
  "protocol_version": 2,
  "encoding": {
    "random_value_pattern": "^[A-Za-z0-9_-]{43}$",
    "client_value_pattern": "^[A-Za-z0-9_-]{43,128}$",
    "completion_challenge_example": {
      "completion_secret": "dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk",
      "completion_challenge": "E9Melhoa2OwvFrEMTJguCHaoeK1t8URWbuGJSstw-cM",
      "completion_challenge_method": "S256"
    }
  },
  "endpoints": {
    "initiate": "POST https://aura-historia.com/api/oauth/client/redirect-broker/woocommerce/transactions",
    "authorization": "GET https://aura-historia.com/oauth/authorize?client_id={client_id}&redirect_uri=https%3A%2F%2Faura-historia.com%2Fapi%2Foauth%2Fclient%2Fredirect-broker%2Fwoocommerce&response_type=code&scope={scope}&state={transaction_id}",
    "complete": "POST https://aura-historia.com/api/oauth/client/redirect-broker/woocommerce/transactions/complete",
    "stage_origin": "https://stage.aura-historia.com"
  },
  "initiate": {
    "request": {
      "headers": {
        "Content-Type": "application/json",
        "Accept": "application/json"
      },
      "json": {
        "protocol_version": 2,
        "client_id": "oc_01m5vyvraxecksre2zepjcza88",
        "merchant_redirect_uri": "https://shop.example/wp-admin/admin.php?page=aura-historia-partner-connect",
        "client_state": "mRB0dSUtBEyJrgVt6xQGFFn0Wd6p8pcQxLwVHAwkiBs",
        "scope": "product-listings:read product-listings:write listing-sources:read listing-sources:write",
        "completion_challenge": "E9Melhoa2OwvFrEMTJguCHaoeK1t8URWbuGJSstw-cM",
        "completion_challenge_method": "S256"
      }
    },
    "response": {
      "status": 201,
      "body": {
        "protocol_version": 2,
        "transaction_id": "q2Jv7Wl3N1m8b0bTt0lpbq3c7S8Dzvq7m3x8W4cnD8I",
        "authorization_url": "https://aura-historia.com/oauth/authorize?client_id=oc_01m5vyvraxecksre2zepjcza88&redirect_uri=https%3A%2F%2Faura-historia.com%2Fapi%2Foauth%2Fclient%2Fredirect-broker%2Fwoocommerce&response_type=code&scope=product-listings%3Aread+product-listings%3Awrite+listing-sources%3Aread+listing-sources%3Awrite&state=q2Jv7Wl3N1m8b0bTt0lpbq3c7S8Dzvq7m3x8W4cnD8I",
        "expires_at": "2026-10-30T12:15:00.000Z"
      },
      "authorization_url_rules": "An OAuth-shaped entry on the broker origin: client_id, redirect_uri (the broker callback), response_type=code, the exact requested scope and the transaction_id as state, nothing else. The consent page reads every value from the stored transaction."
    }
  },
  "merchant_handoff": {
    "location": "https://shop.example/wp-admin/admin.php?page=aura-historia-partner-connect&transaction_id=q2Jv7Wl3N1m8b0bTt0lpbq3c7S8Dzvq7m3x8W4cnD8I&state=mRB0dSUtBEyJrgVt6xQGFFn0Wd6p8pcQxLwVHAwkiBs&completion_code=4Hm0wQ1dE9x2Lr7pYcVn6sKa3TbZ8uJf5gOiWlNqXyE",
    "merchant_redirect_uri_shape": "{site address}wp-admin/admin.php?page=aura-historia-partner-connect",
    "protocol_params": ["transaction_id", "state", "completion_code"],
    "never_present": ["access_token", "code", "code_verifier", "completion_secret", "listing_source_id", "third_party_exchange_code"]
  },
  "complete": {
    "request": {
      "headers": {
        "Content-Type": "application/json",
        "Accept": "application/json"
      },
      "json": {
        "protocol_version": 2,
        "transaction_id": "q2Jv7Wl3N1m8b0bTt0lpbq3c7S8Dzvq7m3x8W4cnD8I",
        "completion_code": "4Hm0wQ1dE9x2Lr7pYcVn6sKa3TbZ8uJf5gOiWlNqXyE",
        "completion_secret": "dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk"
      }
    },
    "responses": {
      "approved": {
        "status": 200,
        "body": {
          "protocol_version": 2,
          "transaction_id": "q2Jv7Wl3N1m8b0bTt0lpbq3c7S8Dzvq7m3x8W4cnD8I",
          "client_state": "mRB0dSUtBEyJrgVt6xQGFFn0Wd6p8pcQxLwVHAwkiBs",
          "outcome": "approved",
          "listing_source_id": "ls_6rd827eqfefsva9teecmwa3ate",
          "access_token": "aurahistoria_example_access_token",
          "token_type": "Bearer",
          "scope": "product-listings:read product-listings:write listing-sources:read listing-sources:write"
        },
        "never_present": ["access_token_expires_at", "expires_in", "refresh_token"],
        "never_present_note": "The broker revokes a token the backend issues with expires_in and reports outcome failed with server_error; the WooCommerce extension has no refresh flow.",
        "optional_fields": {
          "resource": "Present only when the initiation requested one; the exact requested value. The WooCommerce extension never requests one."
        }
      },
      "denied": {
        "status": 200,
        "body": {
          "protocol_version": 2,
          "transaction_id": "q2Jv7Wl3N1m8b0bTt0lpbq3c7S8Dzvq7m3x8W4cnD8I",
          "client_state": "mRB0dSUtBEyJrgVt6xQGFFn0Wd6p8pcQxLwVHAwkiBs",
          "outcome": "denied",
          "error": "access_denied"
        }
      },
      "failed": {
        "status": 200,
        "body": {
          "protocol_version": 2,
          "transaction_id": "q2Jv7Wl3N1m8b0bTt0lpbq3c7S8Dzvq7m3x8W4cnD8I",
          "client_state": "mRB0dSUtBEyJrgVt6xQGFFn0Wd6p8pcQxLwVHAwkiBs",
          "outcome": "failed",
          "error": "invalid_grant"
        },
        "errors": ["invalid_scope", "invalid_target", "invalid_grant", "server_error", "temporarily_unavailable"]
      }
    }
  },
  "endpoint_errors": [
    { "error": "invalid_request", "status": 400, "retryable": false },
    { "error": "unsupported_protocol_version", "status": 400, "retryable": false },
    { "error": "invalid_client", "status": 400, "retryable": false },
    { "error": "invalid_destination", "status": 400, "retryable": false },
    { "error": "invalid_scope", "status": 400, "retryable": false },
    { "error": "invalid_target", "status": 400, "retryable": false },
    { "error": "invalid_completion_challenge", "status": 400, "retryable": false },
    { "error": "invalid_transaction", "status": 400, "retryable": false },
    { "error": "invalid_completion_code", "status": 400, "retryable": false },
    { "error": "invalid_completion_proof", "status": 400, "retryable": false },
    { "error": "transaction_pending", "status": 409, "retryable": true },
    { "error": "transaction_consumed", "status": 409, "retryable": false },
    { "error": "transaction_expired", "status": 410, "retryable": false },
    { "error": "rate_limited", "status": 429, "retryable": true },
    { "error": "server_error", "status": 500, "retryable": false },
    { "error": "temporarily_unavailable", "status": 503, "retryable": true }
  ],
  "endpoint_error_body_example": { "protocol_version": 2, "error": "invalid_completion_proof", "retryable": false }
}
