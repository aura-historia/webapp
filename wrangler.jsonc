{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aura-historia-staging",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  // The registered WooCommerce OAuth client, as a canonical `oc_` TypeID. Its secret is a Worker secret.
  "vars": {
    "OAUTH_CLIENT_REDIRECT_BROKER_WOOCOMMERCE_CLIENT_ID": "oc_01m5vyvraxecksre2zepjcza88"
  }
}
